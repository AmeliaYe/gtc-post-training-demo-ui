# Docker Compose reads ui/.env automatically. Native launch: DEMO_ENV_FILE=ui/.env bash ui/run.sh
UI_PORT=4193
# Leave model IDs blank to start with Recorded preview. Live models are external.
BASELINE_BASE_URL=https://inference-api.nvidia.com/v1
BASELINE_MODEL=
CHECKPOINT_BASE_URL=http://host.docker.internal:18045/v1
CHECKPOINT_MODEL=
# Prefer Connections (memory only), or compose.secrets.yaml for deployment credentials.
BASELINE_API_KEY=
CHECKPOINT_API_KEY=
DEMO_TURN_TIMEOUT=900
# Native Python only (container bind/port are set by Compose):
DEMO_PORT=4193
# Optional compose.share.yaml: use a specific private IP and exact browser origin.
# SHARE_BIND_IP=10.1.2.3
# SHARE_PORT=4195
# DEMO_SHARE_ORIGIN=http://10.1.2.3:4195
# Native only: exact origins allowed to embed the UI in an iframe (space-separated). Default: none.
# DEMO_FRAME_ANCESTORS=http://localhost:3000 http://127.0.0.1:3000
# compose.tunnel.yaml only: SSH tunnel sidecar to the remote model host (password in .secrets/model_host_password).
# MODEL_HOST_ADDRESS=10.110.16.185
# MODEL_HOST_USER=nvidia
# MODEL_TUNNEL_PORT=18045
# Case bundle: single hand-picked live case (default in Compose) or the original six recorded cases.
# Native default is data/cases.json; Compose default is data/cases.live-demo.json.
# DEMO_CASES_FILE=ui/data/cases.live-demo.json   (native, from repo root)
# DEMO_CASES_FILE=/opt/demo/ui/data/cases.json   (Compose, six cases + recordings)

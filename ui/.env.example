# Docker Compose reads ui/.env automatically. Native launch: DEMO_ENV_FILE=ui/.env bash ui/run.sh
UI_PORT=4193
# Leave model IDs blank to start with Recorded preview. Live models are external.
BASELINE_BASE_URL=https://inference-api.nvidia.com/v1
BASELINE_MODEL=
CHECKPOINT_BASE_URL=http://host.docker.internal:18045/v1
CHECKPOINT_MODEL=
# Prefer Connections (memory only), or compose.secrets.yaml for deployment credentials.
BASELINE_API_KEY=
CHECKPOINT_API_KEY=
DEMO_TURN_TIMEOUT=900
# Native Python only (container bind/port are set by Compose):
DEMO_PORT=4193
# Optional compose.share.yaml: use a specific private IP and exact browser origin.
# SHARE_BIND_IP=10.1.2.3
# SHARE_PORT=4195
# DEMO_SHARE_ORIGIN=http://10.1.2.3:4195

# Browser-side PostHog project key. This is an ingestion key, not an admin secret.
NEXT_PUBLIC_POSTHOG_KEY=phc_replace_me
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_DEMO_STATION_ID=gtc-demo-01

# Protects /admin/analytics with HTTP Basic Authentication.
ANALYTICS_ADMIN_USER=admin
ANALYTICS_ADMIN_PASSWORD=replace_with_a_long_random_password

# Server-only values used to read aggregate analytics for the admin dashboard.
POSTHOG_PERSONAL_API_KEY=phx_replace_me
POSTHOG_PROJECT_ID=replace_me
POSTHOG_API_HOST=https://us.posthog.com
